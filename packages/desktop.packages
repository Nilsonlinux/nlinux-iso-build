# Pacotes de desktop (segunda fase do pacstrap).
# Inclui o stack Noctalia disponível nos repositórios oficiais:
#   noctalia   -> shell (repositório [extra])
#   greetd     -> gerenciador de login
#   kitty      -> terminal usado nos keybinds do Umbriel
# Os pacotes AUR (umbriel-git, noctalia-greeter, xdg-desktop-portal-umbriel-git)
# ficam em packages/aur.packages e são construídos pelo yay dentro do chroot.

noctalia
greetd
accountsservice

kitty
showtime
fish
starship
fastfetch
ttf-firacode-nerd
flatpak
packagekit
appstream
zenity

spotify-launcher
discord
telegram-desktop
gpu-screen-recorder
power-profiles-daemon
firefox
nautilus
xdg-user-dirs
gnome-text-editor

wl-clipboard
grim
slurp
imv
swaylock
swayidle

xdg-desktop-portal
xdg-desktop-portal-gtk

# Dependências da Loja de Software NLinux (janela GTK3/WebKit2 em Python)
python
python-gobject
webkit2gtk-4.1

zram-generator

mpv
ffmpeg
imagemagick

jq
yq
