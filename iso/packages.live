# Pacotes extras do ambiente live (ISO) além do releng padrão.
# Ferramentas do instalador + stack do desktop (modo "Experimentar").
# Espelha os apps instalados (packages/desktop.packages) para o live ter
# navegador e programas da mesma lista da instalação.

cryptsetup
gdisk
btrfs-progs
parted
dosfstools
ntfs-3g
python
python-gobject
# GTK4: paridade com a instalação (Showtime/WebKit e janela NLinux Welcome).
gtk4
webkit2gtk-4.1
efibootmgr
polkit

base-devel
git
sudo
noctalia
greetd
accountsservice

# Rede no live (NetworkManager; o systemd-networkd é desativado no
# customize_airootfs.sh para não conflitar)
networkmanager
wpa_supplicant

# Bluetooth (mesmo do packages/base.packages) — o modo offline clona o live;
# sem bluez o clone não tem bluetooth.service e o installer 50-services falha.
bluez
bluez-utils

# Apps e ferramentas do desktop (mesmos da instalação)
kitty
showtime
fish
starship
fastfetch
ttf-firacode-nerd
flatpak
packagekit
appstream
zenity

spotify-launcher
discord
telegram-desktop
gpu-screen-recorder
power-profiles-daemon
firefox
nautilus
gvfs
udisks2
gnome-text-editor
xdg-user-dirs
timeshift

# opencode: agente de programação com IA (extra). Fica no live "Experimentar"
# e, por consequência, no clone offline; o atalho vem do airootfs.
opencode

wl-clipboard
grim
slurp
imv
swaylock
swayidle

# Áudio no live (PipeWire + WirePlumber; serviços habilitados no
# customize_airootfs.sh para o usuário live)
# rtkit: sem ele o PipeWire/WirePlumber abrem mão da prioridade realtime e o
# xdg-desktop-portal reclama na sessão. Não é dependência do wireplumber no Arch.
pipewire
pipewire-pulse
wireplumber
rtkit
# Sons de interface do Noctalia no live também (eventos de volume/notificação).
sound-theme-freedesktop
pamixer

noto-fonts
noto-fonts-cjk
noto-fonts-emoji
terminus-font

xdg-desktop-portal
xdg-desktop-portal-gtk

zram-generator

mpv
mpv-mpris
ffmpeg
# Stack GStreamer completa: codecs extras do Showtime/WebKit (gst-libav usa
# o FFmpeg) e os plugins "bad"; sem eles só entra o gst-plugins-good via
# dependência do Showtime.
gst-libav
gst-plugins-bad
imagemagick

jq
yq

# Paridade com a instalação (packages/base.packages + desktop.packages).
# O modo offline clona o live, então tudo o que o modo online recebe pelo
# pacstrap precisa existir aqui também. Listado de forma explícita para não
# depender de dependências transitivas do releng, que mudam entre releases.
texinfo
openresolv
pipewire-jack
brightnessctl
dbus
gvfs-mtp
fontconfig
ttf-jetbrains-mono-nerd
fzf
ripgrep
fd
eza
bat
btop
wget
curl
unzip
zip
pciutils
pacman-contrib
