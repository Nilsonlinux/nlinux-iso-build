#!/bin/sh
# Instalador web do NLinux (exclusivo) para o modo live.
# Sobe o servidor local (root) e abre o Firefox em tela cheia (kiosk).
# Não há fallback TUI: a instalação é exclusivamente via web.
PORT="${NLINUX_WEB_PORT:-8765}"
URL="http://127.0.0.1:$PORT"
INST="/opt/noctalia-installer"
LOG=/tmp/nlinux-web.log

server_up() {
  python3 - "$PORT" <<'PY'
import socket, sys
s = socket.socket()
s.settimeout(0.5)
try:
    s.connect(("127.0.0.1", int(sys.argv[1])))
    sys.exit(0)
except OSError:
    sys.exit(1)
finally:
    s.close()
PY
}

# Instalador é só web: exige desktop gráfico e navegador no live.
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
  echo "Instalador NLinux: exige o desktop do live (opção 'NLinux ao vivo')." >&2
  exit 1
fi
if ! command -v firefox >/dev/null 2>&1; then
  echo "Instalador NLinux: firefox ausente no live." >&2
  exit 1
fi

# Sobe o servidor como root (o usuário nlinux tem sudo sem senha no live).
if ! server_up; then
  if [ "$(id -u)" -eq 0 ]; then
    setsid python3 "$INST/web/server.py" >"$LOG" 2>&1 < /dev/null &
  else
    sudo -n setsid python3 "$INST/web/server.py" >"$LOG" 2>&1 < /dev/null &
  fi
  i=0
  while [ "$i" -lt 20 ]; do
    server_up && break
    sleep 0.25
    i=$((i + 1))
  done
fi

if ! server_up; then
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --title="Instalador NLinux" \
      --text="Não foi possível iniciar o instalador web.\nVerifique o log: $LOG" \
      2>/dev/null || true
  fi
  echo "Instalador NLinux: servidor web não iniciou (ver $LOG)." >&2
  exit 1
fi

exec firefox --private-window --kiosk "$URL"