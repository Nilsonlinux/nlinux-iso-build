#!/bin/sh
# Instalador web do FalconOS (exclusivo) para o modo live.
# Sobe o servidor local (root) e abre o Firefox em tela cheia (kiosk).
# Não há fallback TUI: a instalação é exclusivamente via web.
PORT="${FALCONOS_WEB_PORT:-8765}"
URL="http://127.0.0.1:$PORT"
INST="/opt/noctalia-installer"
LOG=/tmp/falconos-web.log

server_up() {
  python3 - "$PORT" <<'PY'
import socket, sys
s = socket.socket()
s.settimeout(0.5)
try:
    s.connect(("127.0.0.1", int(sys.argv[1])))
    sys.exit(0)
except OSError:
    sys.exit(1)
finally:
    s.close()
PY
}

# Instalador é só web: exige desktop gráfico e navegador no live.
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
  echo "Instalador FalconOS: exige o desktop do live (opção 'FalconOS ao vivo')." >&2
  exit 1
fi
if ! command -v firefox >/dev/null 2>&1; then
  echo "Instalador FalconOS: firefox ausente no live." >&2
  exit 1
fi

# Sobe o servidor como root (o usuário falconos tem sudo sem senha no live).
# Roda sob um supervisor: se o processo do servidor cair (falta de memória no
# live, por exemplo), ele é reiniciado e reanexa a instalação em andamento em
# vez de deixar o painel morto. O log é acumulado (>>) para não perder o
# diagnóstico de antes da queda.
if ! server_up; then
  SUPERVISOR='while :; do
    echo "--- servidor do instalador (re)iniciado em $(date -Is) ---"
    python3 "$1/web/server.py"
    sleep 2
  done'
  if [ "$(id -u)" -eq 0 ]; then
    setsid sh -c "$SUPERVISOR" sh "$INST" >>"$LOG" 2>&1 < /dev/null &
  else
    sudo -n setsid sh -c "$SUPERVISOR" sh "$INST" >>"$LOG" 2>&1 < /dev/null &
  fi
  i=0
  while [ "$i" -lt 20 ]; do
    server_up && break
    sleep 0.25
    i=$((i + 1))
  done
fi

if ! server_up; then
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --title="Instalador FalconOS" \
      --text="Não foi possível iniciar o instalador web.\nVerifique o log: $LOG" \
      2>/dev/null || true
  fi
  echo "Instalador FalconOS: servidor web não iniciou (ver $LOG)." >&2
  exit 1
fi

exec firefox --private-window --kiosk "$URL"