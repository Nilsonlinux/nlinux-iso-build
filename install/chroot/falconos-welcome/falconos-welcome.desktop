[Desktop Entry]
Type=Application
Version=1.0
Name=falconos-welcome
GenericName=Boas-vindas do FalconOS
Comment=Janela de boas-vindas e informações da distro
Comment[en]=FalconOS welcome window and distro info
Comment[es]=Ventana de bienvenida e información de la distro
Comment[fr]=Fenêtre de bienvenue et infos de la distro
Comment[de]=FalconOS-Willkommensfenster und Distro-Infos
Comment[it]=Finestra di benvenuto e info sulla distro
Comment[ja]=FalconOS のウェルカムウィンドウとディストロ情報
Exec=/usr/local/bin/falconos-welcome --menu
Icon=falconos-welcome
Terminal=false
Categories=System;Utility;
StartupNotify=true
StartupWMClass=falconos-welcome
